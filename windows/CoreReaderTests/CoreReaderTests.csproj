<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks that per-core readings come out as one entry per physical core for several CPU layouts.
       Runs anywhere: it uses a stand-in for LibreHardwareMonitor's SensorType (Stub.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../MytyMonitor/Models.cs" />
    <Compile Include="../MytyMonitor/CoreReader.cs" />
  </ItemGroup>
</Project>
